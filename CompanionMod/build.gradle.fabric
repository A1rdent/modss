// Sample Fabric build file (do NOT overwrite original build.gradle until ready)
// Review and rename to build.gradle when ready to switch to Fabric Loom.

plugins {
    id 'fabric-loom' version '0.12.55'
    id 'maven-publish'
}

version = "${project.hasProperty('mod_version') ? project.getProperty('mod_version') : '1.0.0'}"
group = 'com.example.companionmod'

java {
    toolchain.languageVersion.set(JavaLanguageVersion.of(17))
}

repositories {
    mavenCentral()
    maven { url = 'https://maven.fabricmc.net/' }
}

dependencies {
    // Minecraft and mappings are configured by Loom
    minecraft 'com.mojang:minecraft:1.19.1'
    mappings 'net.fabricmc:yarn:1.19.1+build.29:v2'

    // Fabric API - pin a version later
    modImplementation 'net.fabricmc.fabric-api:fabric-api:0.79.0+1.19.1'
}

// Additional Loom configuration (runs, remapJar etc.) can be added here

tasks.withType(JavaCompile).configureEach {
    options.encoding = 'UTF-8'
}
